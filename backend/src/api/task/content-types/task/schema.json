{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "required": true
    },
    "description": {
      "type": "text",
      "minLength": 1,
      "maxLength": 400,
      "required": true
    },
    "column": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::column.column",
      "inversedBy": "tasks"
    },
    "subtask": {
      "type": "component",
      "component": "layout.sub-task",
      "repeatable": true
    }
  }
}
