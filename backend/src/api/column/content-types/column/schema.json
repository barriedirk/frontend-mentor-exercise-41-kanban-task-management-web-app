{
  "kind": "collectionType",
  "collectionName": "columns",
  "info": {
    "singularName": "column",
    "pluralName": "columns",
    "displayName": "Column"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "required": true
    },
    "position": {
      "type": "integer",
      "default": 10
    },
    "board": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::board.board",
      "inversedBy": "columns"
    },
    "tasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::task.task",
      "mappedBy": "column"
    }
  }
}
